import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
from sklearn.model_selection import train_test_split
from scipy.stats import shapiro, skew, kurtosis
from sklearn.preprocessing import RobustScaler  
from sklearn.feature_selection import VarianceThreshold
import joblib

warnings.filterwarnings("ignore", category=pd.errors.PerformanceWarning)

# Load data
data_path = '../../TM10011-Machine-Learning-Head-Neck/hn/HN_radiomicFeatures.csv'
data = pd.read_csv(data_path)
print("\nDataset loaded.")

# Prepare data
data["Label_binary"] = data["label"].map({'T12': 0, 'T34': 1})
features = data.drop(columns=["ID", "label", "Label_binary"]).columns
# Split the dataset into training and testing sets
train_data, test_data = train_test_split(data, test_size=0.2, random_state=42)


# Reset indices after split
train_data = train_data.reset_index(drop=True)
test_data = test_data.reset_index(drop=True)

# Print the number of features and samples
print(f"Aantal features: {len(features)}")
print(f"Aantal samples in de trainingsset: {len(train_data)}")
print(f"Aantal samples in de testset: {len(test_data)}")

#%% Distribution analysis on training set
features_to_plot = features[:12]

# Plot distributions
n_cols = 3
n_rows = (len(features_to_plot) // n_cols) + (1 if len(features_to_plot) % n_cols != 0 else 0)

plt.figure(figsize=(20, 5 * n_rows))
for i, feature in enumerate(features_to_plot):
    plt.subplot(n_rows, n_cols, i + 1)
    for label_value in [0, 1]:
        sns.histplot(train_data[train_data["Label_binary"] == label_value][feature], 
                     bins=30, kde=True, label=f'label {label_value}', 
                     element='step', stat='density')
    plt.title(feature)
    plt.legend()
plt.tight_layout()
plt.show()

# Shapiro-Wilk test
normality_scores = []
for feature in features:
    for label_value in [0, 1]:
        filtered_data = train_data[train_data["Label_binary"] == label_value][feature]
        stat, p_value = shapiro(filtered_data)
        normality_scores.append({
            'Feature': feature,
            'label': label_value,
            'P_Value': p_value,
            'Normality': 'Normal' if p_value > 0.05 else 'Abnormal',
        })

# Save normality test results
normality_scores_df = pd.DataFrame(normality_scores)
print(normality_scores_df)
normality_scores_df.to_csv('normality_scores.csv', index=False)

# Count normal and abnormal features
normal_count = normality_scores_df['Normality'].value_counts().get('Normal', 0)
abnormal_count = normality_scores_df['Normality'].value_counts().get('Abnormal', 0)

total_features = normal_count + abnormal_count
normal_percentage = (normal_count / total_features) * 100 if total_features else 0
abnormal_percentage = (abnormal_count / total_features) * 100 if total_features else 0

print(f"Percentage normal features: {normal_percentage:.2f}%")
print(f"Percentage abnormal features: {abnormal_percentage:.2f}%")

# Save training and testing sets to CSV
train_data.to_csv('train_data.csv', index=False)
test_data.to_csv('test_data.csv', index=False)

print("Datasets zijn opgeslagen in 'train_data.csv' en 'test_data.csv'.")

